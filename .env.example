# Copy to .env with: python scripts/bootstrap_env.py
# Never commit .env or any real provider credential.
WHALEGUARD_ENVIRONMENT=development
WHALEGUARD_APP_NAME=WhaleGuard AI RedLab
WHALEGUARD_BIND_HOST=127.0.0.1
WHALEGUARD_BIND_PORT=8000
WHALEGUARD_APP_UID=1000
WHALEGUARD_APP_GID=1000
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
WHALEGUARD_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# bootstrap_env.py replaces the GENERATE_* markers in the local .env file.
WHALEGUARD_JWT_SECRET=GENERATE_JWT_SECRET
WHALEGUARD_ENCRYPTION_SECRET=GENERATE_FERNET_KEY
WG_WORKER_TOKEN=GENERATE_WORKER_TOKEN
WHALEGUARD_ACCESS_TOKEN_MINUTES=30

WHALEGUARD_DATABASE_URL=postgresql+psycopg://whaleguard:GENERATE_POSTGRES_PASSWORD@db:5432/whaleguard
REDIS_PASSWORD=GENERATE_REDIS_PASSWORD
WHALEGUARD_REDIS_URL=redis://:GENERATE_REDIS_PASSWORD@redis:6379/0
REDIS_URL=redis://:GENERATE_REDIS_PASSWORD@redis:6379/0
RQ_QUEUE=whaleguard
WG_WORKER_ALLOWED_API_ORIGINS=http://api:8000,http://127.0.0.1:8000,http://localhost:8000

POSTGRES_DB=whaleguard
POSTGRES_USER=whaleguard
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD

# Empty means the API creates a random one-time administrator password in the
# ignored credential file below. Logs print only the file path, never the password.
WHALEGUARD_ADMIN_EMAIL=admin@whaleguard.local
WHALEGUARD_ADMIN_PASSWORD=
WHALEGUARD_CREDENTIALS_FILE=/app/.local/first-run-credentials.txt

WHALEGUARD_MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO

# Mock services are reachable only on the Docker private arena network.
MOCK_LLM_URL=http://mock-llm:8101
MOCK_AGENT_URL=http://mock-agent:8102
MOCK_MCP_URL=http://mock-mcp-server:8103
